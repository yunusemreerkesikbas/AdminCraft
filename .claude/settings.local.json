{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_COST_WARNINGS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(Select-Object ProcessName, Id)",
      "Bash(Format-Table)",
      "Bash(tasklist:*)",
      "Bash(dir:*)",
      "Bash(mkdir:*)",
      "Bash(nul)",
      "Bash(findstr:*)",
      "Bash(mvn compile:*)",
      "Bash(cat:*)",
      "Bash(rm:*)",
      "Bash(move \"V1__baseline.sql\" \"V4__component_library_baseline.sql\")",
      "Bash(mvn clean:*)",
      "Bash(git diff:*)",
      "Bash(git config:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(npm run build:*)",
      "Bash(find:*)",
      "Bash(mvn spring-boot:run:*)",
      "Bash(timeout:*)",
      "Bash(exit 0)",
      "Bash(mvn test-compile:*)",
      "Bash(docker compose:*)",
      "Bash(powershell -Command \"curl -s http://localhost:8080/actuator/health 2>&1\")",
      "Bash(powershell -Command \"Invoke-WebRequest -Uri http://localhost:8080/actuator/health -UseBasicParsing | Select-Object -ExpandProperty Content\")",
      "Bash(powershell -Command \"Invoke-WebRequest -Uri http://localhost:8080/api/actuator/health -UseBasicParsing | Select-Object -ExpandProperty Content\")",
      "Bash(powershell -Command \"try { $response = Invoke-WebRequest -Uri ''http://democompany.localhost:4200/api/components'' -UseBasicParsing; $response.Content } catch { $_Exception.Message }\")",
      "Bash(powershell:*)",
      "Bash(xargs -I {} sh -c 'echo \"\"\"\"=== {} ===\"\"\"\" && head -3 {}')",
      "Bash(xargs -I {} bash -c 'echo \"\"\"\"=== {} ===\"\"\"\" && cat {}')",
      "Bash(grep:*)"
    ],
    "deny": [],
    "ask": [],
    "additionalDirectories": [
      "C:\\c\\Users\\emreerkesikbas\\Documents\\AdminCraft"
    ]
  },
  "enabledMcpjsonServers": [
    "serena",
    "sequential-thinking",
    "tavily-remote-mcp",
    "memory",
    "executeautomation-playwright-server"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if git rev-parse --git-dir >/dev/null 2>&1 && [[ -n \"$CLAUDE_TOOL_FILE_PATH\" ]]; then git add \"$CLAUDE_TOOL_FILE_PATH\" 2>/dev/null; CHANGED_LINES=$(git diff --cached --numstat \"$CLAUDE_TOOL_FILE_PATH\" 2>/dev/null | awk '{print $1+$2}'); if [[ $CHANGED_LINES -gt 0 ]]; then FILENAME=$(basename \"$CLAUDE_TOOL_FILE_PATH\"); if [[ $CHANGED_LINES -lt 10 ]]; then SIZE=\"minor\"; elif [[ $CHANGED_LINES -lt 50 ]]; then SIZE=\"moderate\"; else SIZE=\"major\"; fi; MSG=\"Update $FILENAME: $SIZE changes ($CHANGED_LINES lines)\"; git commit -m \"$MSG\" \"$CLAUDE_TOOL_FILE_PATH\" 2>/dev/null || true; fi; fi"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if git rev-parse --git-dir >/dev/null 2>&1 && [[ -n \"$CLAUDE_TOOL_FILE_PATH\" ]]; then git add \"$CLAUDE_TOOL_FILE_PATH\" 2>/dev/null; FILENAME=$(basename \"$CLAUDE_TOOL_FILE_PATH\"); git commit -m \"Add new file: $FILENAME\" \"$CLAUDE_TOOL_FILE_PATH\" 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/scripts/context-monitor.py"
  }
}
