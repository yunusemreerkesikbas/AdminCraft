# Craftive Environment Configuration
# Copy this file and rename according to your environment:
#   - .env.dev   (local development)
#   - .env.stage (staging VPS)
#   - .env.prod  (production VPS)

# ===========================================
# DATABASE
# ===========================================
DB_PASSWORD=change_this_secure_password

# ===========================================
# APPLICATION
# ===========================================
# Version tag for Docker images
APP_VERSION=latest

# Spring profile: dev, stage, prod
SPRING_PROFILE=prod

# JWT Secret (minimum 64 characters for HS512)
JWT_SECRET=change_this_to_64_char_minimum_secret_key_for_jwt_signing_in_production

# Encryption key for sensitive data (exactly 32 characters)
RECAPTCHA_MASTER_KEY=change_this_to_exactly_32_chars!

# ===========================================
# DOMAIN & SSL
# ===========================================
# Production: craftive.io  |  Stage: craftive.io (s1.* prefix via Traefik)
DOMAIN=craftive.io

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@craftive.io

# Cloudflare API token (DNS-01 challenge + DNS management)
# Permissions required: Zone:DNS:Edit
CF_API_TOKEN=your_cloudflare_api_token_here

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@craftive.io
SMTP_PASSWORD=your_smtp_password

# ===========================================
# TIMEZONE
# ===========================================
TZ=Europe/Istanbul
