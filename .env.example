# Craftive Environment Configuration
# Copy this file and rename according to your environment:
#   - .env.dev   (local development)
#   - .env.stage (staging VPS)
#   - .env.prod  (production VPS)

# ===========================================
# DATABASE
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=craftive
DB_PASSWORD=change_this_secure_password

# ===========================================
# APPLICATION
# ===========================================
# Version tag for Docker images
APP_VERSION=latest

# Spring profile: dev, stage, prod
SPRING_PROFILE=prod
SPRING_PROFILES_ACTIVE=prod

# JWT Secret (minimum 64 characters for HS512)
JWT_SECRET=change_this_to_64_char_minimum_secret_key_for_jwt_signing_in_production

# Encryption key for sensitive data (exactly 32 characters)
RECAPTCHA_MASTER_KEY=change_this_to_exactly_32_chars!

# Platform/frontend URLs
APP_FRONTEND_BASE_URL=https://%s.craftive.io
PLATFORM_DOMAIN=craftive.io

# ===========================================
# DOMAIN & SSL
# ===========================================
# Production: craftive.io  |  Stage: craftive.io (s1.* prefix via Traefik)
DOMAIN=craftive.io

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@craftive.io

# Cloudflare API token (DNS-01 challenge + DNS management)
# Permissions required: Zone:DNS:Edit
CF_API_TOKEN=your_cloudflare_api_token_here

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@craftive.io
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM_ADDRESS=noreply@craftive.io
EMAIL_FROM_NAME=Craftive

# ===========================================
# OBJECT STORAGE (S3-compatible: Cloudflare R2, MinIO, etc.)
# ===========================================
# Dev only: override storage provider for local S3/MinIO testing.
# DO NOT set this in .env.stage or .env.prod — application-stage/prod.yml already hardcodes provider=s3.
# Setting STORAGE_PROVIDER=local in stage/prod would break uploads.
STORAGE_PROVIDER=local

# Use separate key pairs per environment. Cloudflare R2 uses region "auto".
# Required when STORAGE_PROVIDER=s3 (all stage/prod deploys).
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_CDN_BASE_URL=

# ===========================================
# TIMEZONE
# ===========================================
TZ=Europe/Istanbul

# ===========================================
# OBSERVABILITY (Grafana Cloud Loki + Alloy)
# ===========================================
# Loki push endpoint (example: https://logs-prod-xxx.grafana.net/loki/api/v1/push)
GRAFANA_CLOUD_LOKI_URL=
# Loki instance username from Grafana Cloud
GRAFANA_CLOUD_LOKI_USER=
# Grafana Cloud API token with logs:write scope
GRAFANA_CLOUD_LOKI_TOKEN=

# Log labels
LOG_ENV=prod
# Distinct host label for queries (example: do-fra1-prod-01)
LOG_HOST=do-fra1-prod-01
APP_SEO_CRUX_API_KEY=your_crux_api_key_here

# ===========================================
# CMS PREVIEW (SmartEdit)
# ===========================================
# HMAC-SHA256 imza anahtarı — tüm ortamlarda zorunlu, min 32 karakter rastgele değer.
CMS_PREVIEW_SECRET=
# Token geçerlilik süresi (saniye). Varsayılan: 900 (15 dakika).
# CMS_PREVIEW_TTL_SECONDS=900
#
# Preview bileti yanıtındaki storefront origin yalnızca tenant Site Dashboard → SEO → Canonical Base URL ayarından gelir.
