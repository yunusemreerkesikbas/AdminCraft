# Required - backend API base URL
NEXT_PUBLIC_COMMERCE_API_URL=http://localhost:8080/api

# Required - tenant identity for this storefront instance
TENANT_SUBDOMAIN=demo
# TENANT_ID=your-tenant-id

# Optional - set when a deployment must only answer for one host
# TENANT_HOSTNAME=shop.example.com

# Optional - when a trusted reverse proxy owns X-Forwarded-Host
# TRUST_X_FORWARDED_HOST=false

# Optional analytics/search verification
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional comma-separated remote image hosts
# NEXT_IMAGE_DOMAINS=cdn.example.com,assets.example.com
