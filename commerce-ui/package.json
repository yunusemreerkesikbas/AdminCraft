{
  "name": "commerce-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ssr": "next dev",
    "dev:stage": "cross-env TENANT_HOSTNAME= dotenv -e .env.staging -- next dev",
    "dev:prod": "cross-env TENANT_HOSTNAME= dotenv -e .env.production -- next dev",
    "build": "dotenv -e .env.production -- next build",
    "build:dev": "dotenv -e .env.development -- next build",
    "build:stage": "dotenv -e .env.staging -- next build",
    "build:prod": "dotenv -e .env.production -- next build",
    "build:static": "cross-env NEXT_OUTPUT=export dotenv -e .env.production -- next build",
    "build:static:stage": "cross-env NEXT_OUTPUT=export dotenv -e .env.staging -- next build",
    "start": "next dev",
    "start:dev": "next dev",
    "start:stage": "cross-env TENANT_HOSTNAME= dotenv -e .env.staging -- next dev",
    "start:prod": "cross-env TENANT_HOSTNAME= dotenv -e .env.production -- next dev",
    "serve": "dotenv -e .env.production -- next start",
    "serve:dev": "dotenv -e .env.development -- next start",
    "serve:stage": "cross-env TENANT_HOSTNAME= dotenv -e .env.staging -- next start",
    "serve:prod": "dotenv -e .env.production -- next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.1.6",
    "next-intl": "^4.8.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "serve": "^14.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
