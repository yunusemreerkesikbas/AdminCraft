# Backend API origin (no /api suffix). Required for demo + newsletter forms.
NEXT_PUBLIC_CRAFTIVE_API_URL=https://api.craftive.io

# Canonical public origin used for metadata, canonical URLs, sitemap, robots,
# and JSON-LD. No trailing slash. Defaults to https://craftive.io when unset.
NEXT_PUBLIC_SITE_URL=https://craftive.io

# GA4 Measurement ID (G-XXXXXXXXXX). When empty, analytics + the cookie consent
# banner are disabled (no gtag, no events). Set in the Cloudflare Pages build env.
NEXT_PUBLIC_GA_ID=
