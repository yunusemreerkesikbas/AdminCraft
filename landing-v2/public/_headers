# Cloudflare Pages headers (copied to out/_headers at build).
# The next/og opengraph-image route is emitted as an extensionless file
# (out/<locale>/opengraph-image), so static hosts cannot infer its MIME type.
# Force image/png so social crawlers render the Open Graph / Twitter card image.
/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
