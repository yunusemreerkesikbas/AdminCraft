// Alloy config for local development — pushes to local Loki (no auth).
// Based on alloy.river but without host log collection and Grafana Cloud auth.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/craftive-alloy"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.redact.receiver]
}

// PII redaction — same rules as production
loki.process "redact" {
  forward_to = [loki.write.local.receiver]

  stage.replace {
    expression = "(?i)authorization\\s*[:=]\\s*bearer\\s+(\\S+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)cookie\\s*[:=]\\s*(.*)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "(?i)(?:password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token)\\s*[:=]\\s*(\\S+)"
    replace    = "[REDACTED]"
  }

  stage.replace {
    expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
    replace    = "[REDACTED_EMAIL]"
  }

  stage.replace {
    expression = "(\\+?\\d[\\d() .-]{8,}\\d)"
    replace    = "[REDACTED_PHONE]"
  }
}

loki.write "local" {
  external_labels = {
    env       = sys.env("LOG_ENV"),
    host      = sys.env("LOG_HOST"),
    collector = "alloy",
  }

  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
