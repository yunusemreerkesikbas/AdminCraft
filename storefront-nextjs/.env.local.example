# Required
NEXT_PUBLIC_CMS_API_URL=http://localhost:8080/api

# Required — tenant subdomain for this deployment (set per fork/instance)
TENANT_SUBDOMAIN=demo

# Optional — expected hostname for this deployment. Requests from other hostnames return 404.
# Leave unset in local dev (localhost has no restriction).
# TENANT_HOSTNAME=s1-demo.craftive.io

# Optional — alternative to TENANT_SUBDOMAIN (identify by numeric tenant ID)
# TENANT_ID=your-tenant-id

# Optional - Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Optional - Image domains (comma-separated hostnames, e.g. cdn.example.com)
# Dev mode automatically includes localhost/127.0.0.1; CMS API hostname is auto-detected.
NEXT_IMAGE_DOMAINS=
