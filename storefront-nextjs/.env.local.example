# Required
NEXT_PUBLIC_CMS_API_URL=http://localhost:8080/api

# Tenant identification — choose ONE of the three options below:

# Option A: Single-tenant deployment (local dev / dedicated instance per tenant)
TENANT_SUBDOMAIN=demo

# Option B: Multi-tenant deployment — all tenants on one deployment, resolved by hostname.
# Use {subdomain} as a placeholder. Example: s1-{subdomain}.craftive.io
# TENANT_HOSTNAME_PATTERN=s1-{subdomain}.craftive.io

# Option C: Alternative to TENANT_SUBDOMAIN — identify by numeric tenant ID
# TENANT_ID=your-tenant-id

# Optional - Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Optional - Image domains (comma-separated hostnames, e.g. *.craftive.io,cdn.example.com)
# Dev mode automatically includes localhost/127.0.0.1; CMS API hostname is auto-detected.
NEXT_IMAGE_DOMAINS=
