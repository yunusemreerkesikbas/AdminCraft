/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compileOnSave": false,
    "compilerOptions": {
        "baseUrl": "./src",
        "outDir": "./dist/out-tsc",
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": false,
        "experimentalDecorators": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "target": "ES2022",
        "module": "ES2022",
        "useDefineForClassFields": false,
        "lib": ["ES2022", "dom"],
        "paths": {
            "@/*": ["*"],
            "@app/*": ["app/*"],
            "@core/*": ["app/core/*"],
            "@shared/*": ["app/shared/*"],
            "@api/*": ["app/core/api/*"],
            "@components/*": ["app/shared/components/*"],
            "@services/*": ["app/core/services/*"],
            "@layouts/*": ["app/layout/*"],
            "@modules/*": ["app/modules/*"],
            "@auth/*": ["app/core/auth/*"],
            "@guards/*": ["app/core/auth/guards/*"],
            "@interceptors/*": ["app/core/interceptors/*"],
            "@pipes/*": ["app/shared/pipes/*"],
            "@directives/*": ["app/shared/directives/*"],
            "@validators/*": ["app/shared/validators/*"],
            "@models/*": ["app/shared/models/*"],
            "@types/*": ["app/shared/types/*"],
            "@utils/*": ["app/shared/utils/*"],
            "@constants/*": ["app/shared/constants/*"],
            "@environments/*": ["environments/*"],
            "@assets/*": ["assets/*"],
            "@fuse": ["@fuse/index"],
            "@fuse/*": ["@fuse/*"],
            "@i18n/*": ["app/i18n/*"],
            "@admincraft/*": ["app/modules/admin/apps/admincraft/*"],
            "@tenants/*": ["app/modules/admin/apps/admincraft/tenants/*"],
            "@content/*": ["app/modules/admin/apps/admincraft/content/*"],
            "@media/*": ["app/modules/admin/apps/admincraft/media/*"],
            "@users/*": ["app/modules/admin/apps/admincraft/users/*"],
            "@sites/*": ["app/modules/admin/apps/admincraft/sites/*"]
        }
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false
    }
}
